{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/nixward/blob/main/docs/schemas/nixward-source-evidence-predicate-v1.schema.json",
  "title": "Nixward source-evidence predicate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "materials",
    "builder"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_uri",
        "commit_sha"
      ],
      "properties": {
        "repository_uri": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 2048
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flake_lock_sha256",
        "corpus_sha256",
        "source_inputs_sha256"
      ],
      "properties": {
        "flake_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "corpus_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_inputs_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
