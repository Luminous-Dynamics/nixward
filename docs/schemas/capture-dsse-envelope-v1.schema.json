{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/nixward/blob/main/docs/schemas/capture-dsse-envelope-v1.schema.json",
  "title": "Nixward DSSE envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payloadType",
    "payload",
    "signatures"
  ],
  "properties": {
    "payloadType": {
      "const": "application/vnd.in-toto+json"
    },
    "payload": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 4,
      "maxLength": 16777216
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sig"
        ],
        "properties": {
          "keyid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sig": {
            "type": "string",
            "contentEncoding": "base64",
            "minLength": 80,
            "maxLength": 128
          }
        }
      }
    }
  }
}
