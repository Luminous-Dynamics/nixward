                    },
                    "replay_key": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "permit_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "plan_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "machine_binding_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "policy_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "policy_epoch": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "policy_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "policy_record_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "signer_key_id": {
                      "type": "string",
