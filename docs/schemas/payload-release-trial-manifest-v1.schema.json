                    "release_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "wall_time_ms": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "seq",
                    "at_ns",
                    "request_id",
                    "release_id",
                    "attempt_id",
                    "payload_digest",
                    "wall_time_ms"
