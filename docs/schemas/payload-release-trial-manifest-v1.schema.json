          "trial_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "started_monotonic_ns": {
            "type": "integer",
            "minimum": 0
          },
          "finished_monotonic_ns": {
            "type": "integer",
            "minimum": 1
          },
          "initial_policy_epoch": {
            "type": "integer",
            "minimum": 1
          },
          "initial_policy_id": {
            "type": "string",
            "minLength": 1
          },
          "initial_policy_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "initial_policy_record_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "events_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
