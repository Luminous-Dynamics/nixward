                      "uniqueItems": true
                    },
                    "decisions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "release_id",
                          "disposition"
                        ],
                        "properties": {
                          "release_id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "disposition": {
                            "enum": [
                              "preserve_existing_barrier",
                              "stop_or_recovery_required"
                            ]
                          }
                        }
                      }
                    },
                    "new_policy_allowed_signers": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "new_policy_allowed_audiences": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "new_policy_allowed_actions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
