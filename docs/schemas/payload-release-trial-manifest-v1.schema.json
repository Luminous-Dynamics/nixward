                  "required": [
                    "kind",
                    "seq",
                    "at_ns",
                    "request_id",
                    "from_epoch",
                    "to_epoch",
                    "previous_record_digest",
                    "new_policy_id",
                    "new_policy_digest",
                    "new_record_digest",
                    "emergency_revoked_signers",
                    "decisions",
                    "new_policy_allowed_signers",
                    "new_policy_allowed_audiences",
                    "new_policy_allowed_actions"
                  ],
                  "properties": {
                    "kind": {
                      "const": "policy_advanced"
                    },
                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "at_ns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "from_epoch": {
                      "type": "integer",
                      "minimum": 1
