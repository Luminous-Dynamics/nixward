                    },
                    "authority_provenance_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "authority_subject_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "authority_audience": {
                      "enum": [
                        "nixward-change-v1",
                        "nixward-execution-intent-v1"
                      ]
                    },
                    "payload_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "expires_at_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "wall_time_ms": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "seq",
                    "at_ns",
                    "request_id",
                    "release_id"
