                  "properties": {
                    "kind": {
                      "const": "barrier_create_requested"
                    },
                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "at_ns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "admission_commit_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "expected_policy_epoch": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "expected_policy_record_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "signer_key_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_authority_subject_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "expected_authority_audience": {
                      "enum": [
                        "nixward-change-v1",
                        "nixward-execution-intent-v1"
                      ]
                    },
                    "payload_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "expires_at_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "expected_policy_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_policy_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "wall_time_ms": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "seq",
                    "at_ns",
                    "request_id",
                    "release_id",
                    "admission_commit_id",
                    "transaction_id",
                    "attempt_id",
                    "replay_key",
                    "permit_digest",
                    "plan_digest",
                    "machine_binding_digest",
                    "policy_id",
                    "policy_epoch",
                    "policy_digest",
                    "policy_record_digest",
                    "signer_key_id",
                    "authority_provenance_digest",
                    "authority_subject_digest",
                    "authority_audience",
                    "payload_digest",
                    "expires_at_ms",
                    "wall_time_ms"
                  ],
                  "properties": {
                    "kind": {
                      "const": "barrier_committed"
                    },
                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "at_ns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "release_id": {
                      "type": "string",
