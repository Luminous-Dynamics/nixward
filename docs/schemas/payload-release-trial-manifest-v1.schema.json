{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/nixward/blob/main/docs/schemas/payload-release-trial-manifest-v1.schema.json",
  "title": "Nixward payload-release trial manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "corpus_sha256",
    "source_commit_sha",
    "flake_lock_sha256",
    "environment",
    "trials"
  ],
  "properties": {
    "schema": {
