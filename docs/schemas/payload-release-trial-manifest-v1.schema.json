    },
    "version": {
      "const": 1
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "flake_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_release",
        "systemd_version",
        "sqlite_version",
        "nix_version",
        "filesystem",
        "mount_options",
        "device_model",
        "device_firmware",
        "cpu_model",
        "boot_id"
      ],
      "properties": {
        "kernel_release": {
          "type": "string",
          "minLength": 1
        },
        "systemd_version": {
          "type": "string",
          "minLength": 1
        },
        "sqlite_version": {
          "type": "string",
          "minLength": 1
        },
        "nix_version": {
          "type": "string",
          "minLength": 1
        },
        "filesystem": {
          "type": "string",
          "minLength": 1
        },
        "mount_options": {
          "type": "string",
          "minLength": 1
        },
        "device_model": {
          "type": "string",
          "minLength": 1
        },
        "device_firmware": {
          "type": "string",
          "minLength": 1
        },
        "cpu_model": {
          "type": "string",
          "minLength": 1
        },
        "boot_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trials": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "scenario_id",
          "started_monotonic_ns",
          "finished_monotonic_ns",
          "initial_policy_epoch",
          "initial_policy_id",
          "initial_policy_digest",
          "initial_policy_record_digest",
          "events_sha256",
          "events",
          "artifacts"
