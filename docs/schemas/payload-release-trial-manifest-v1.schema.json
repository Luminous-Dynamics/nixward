                      "type": "integer",
                      "minimum": 0
                    },
                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_epoch": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "expected_record_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
