                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "at_ns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "release_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "seq",
                    "at_ns",
                    "request_id",
                    "expected_epoch",
                    "expected_record_digest"
                  ],
                  "properties": {
                    "kind": {
                      "const": "policy_advance_requested"
