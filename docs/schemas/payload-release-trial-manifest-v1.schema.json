                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "seq",
                    "at_ns",
                    "request_id",
                    "admission_commit_id",
                    "expected_policy_epoch",
                    "expected_policy_record_digest",
                    "signer_key_id",
                    "expected_authority_subject_digest",
                    "expected_authority_audience",
                    "payload_digest",
                    "expires_at_ms",
                    "expected_policy_id",
                    "expected_policy_digest",
                    "wall_time_ms"
