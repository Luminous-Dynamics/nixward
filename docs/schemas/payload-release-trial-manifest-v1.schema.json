                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "release_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "attempt_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "wall_time_ms": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
