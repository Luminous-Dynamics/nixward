                    },
                    "new_policy_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "new_record_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "emergency_revoked_signers": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
