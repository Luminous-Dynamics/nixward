                    "kind": {
                      "const": "payload_write_started"
                    },
                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "at_ns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "release_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "payload_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
