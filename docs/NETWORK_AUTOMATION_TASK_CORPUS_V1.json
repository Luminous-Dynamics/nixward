{
  "schema_version": 1,
  "artifact_id": "nixward.network-automation-task-corpus.v1",
  "status": "qualification-design-only",
  "created_on": "2026-10-12",
  "purpose": "Seed a deterministic task-level qualification corpus for network automation. This file is an input to future tests and reviews, not executable policy or authorization.",
  "claim_boundaries": [
    "A tier ceiling is not an authorization grant.",
    "The effective autonomy tier is the lower of policy, verified evidence, backend capability, target criticality, and change-window limits.",
    "Symthaea recommendations and confidence scores never grant execution authority.",
    "A task counts as safely auto-completed only after independent postcondition verification.",
    "Simulation, lab, and production outcomes must be counted separately.",
    "This seed corpus is not yet representative and cannot justify a fleet-wide automation percentage."
  ],
  "autonomy_tiers": {
    "A0": "Manual; automation records evidence only.",
    "A1": "Observe; collect and correlate without mutation.",
    "A2": "Recommend; produce a reviewable plan without mutation.",
    "A3": "Pre-authorized bounded action; only a previously enumerated operation inside narrow policy limits.",
    "A4": "Exact-plan, change-specific human approval required before execution.",
    "A5": "Human-led exceptional decision and operation; automation advises and preserves evidence."
  },
  "common_hard_stops": [
    "target_or_namespace_identity_mismatch",
    "required_evidence_missing_incomplete_invalid_or_stale",
    "unknown_or_conflicting_configuration_owner",
    "unsupported_backend_capability_or_schema",
    "external_writer_race_not_controlled",
    "blast_radius_exceeds_policy",
    "management_or_recovery_path_not_independently_verified",
    "plan_digest_or_target_set_changed_after_review",
    "health_threshold_breached",
    "outcome_indeterminate_or_journal_unavailable"
  ],
