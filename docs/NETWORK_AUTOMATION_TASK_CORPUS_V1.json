  "evaluation_semantics": {
    "shared_stop_condition_reference": "If a task's stop_conditions contains the exact token common_hard_stops, the evaluator must expand it to every entry in the root common_hard_stops array before evaluating the task.",
    "tier_ceiling": "max_tier_after_qualification is a candidate ceiling after all gates, never a permission; policy or evidence can always lower or block it.",
    "pass_definition": "A task is successful only if each declared postcondition is independently observed and bound to the exact target, plan, and run receipt.",
    "indeterminate_definition": "If apply or recovery outcome cannot be established independently, record Indeterminate; do not count it as a successful completion or start a conflicting write.",
    "measurement": "Use measurement_unit as a denominator seed. Record event count and operational impact separately, and stratify simulation, lab, and production.",
    "corpus_limit": "The 16 entries are examples to drive implementation and test design, not a representative production sample."
  }
}
