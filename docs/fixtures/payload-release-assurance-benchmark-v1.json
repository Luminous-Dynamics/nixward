        "admission_commit_and_release_id",
        "policy_epoch_and_record_digest",
        "payload_digest_and_attempt_state",
        "monotonic_timestamps",
        "raw_sqlite_and_supervisor_logs",
        "raw_policy_epoch_archive"
      ]
    },
