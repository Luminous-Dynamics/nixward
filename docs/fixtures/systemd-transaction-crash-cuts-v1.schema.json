{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/nixward/schemas/systemd-transaction-crash-cuts-v1.json",
  "title":"Nixward systemd transaction crash-cut matrix v1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","claim_ceiling","prerequisites","cuts","controls","result_dimensions","promotion_gates"],
  "properties":{
    "schema":{"const":"org.luminousdynamics.nixward.systemd-crash-cut-matrix"},
    "version":{"const":1},
    "status":{"const":"research_only_vm_qualification_plan"},
    "claim_ceiling":{"type":"string","minLength":80},
    "prerequisites":{"type":"array","minItems":5,"items":{"type":"string","minLength":10}},
    "cuts":{
      "type":"array","minItems":15,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","fault_class","cut_after","inject","durable_prefix","manager_state","expected_disposition","allowed_action","same_attempt_replay","new_attempt_allowed","required_evidence","safety_invariant"],
        "properties":{
          "id":{"type":"string","pattern":"^C[0-9]{3}$"},
          "fault_class":{"enum":["process_crash","systemd_manager_restart","vm_reboot","storage_error"]},
          "cut_after":{"type":"string","minLength":3},
          "inject":{"type":"string","minLength":20},
          "durable_prefix":{"type":"string","minLength":10},
          "manager_state":{"type":"string","minLength":10},
          "expected_disposition":{"enum":["no_attempt","incomplete","indeterminate","rejected","validated_terminal_success"]},
          "allowed_action":{"type":"string","minLength":10},
          "same_attempt_replay":{"const":false},
          "new_attempt_allowed":{"type":"boolean"},
          "required_evidence":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":3}},
          "safety_invariant":{"type":"string","minLength":20}
        }
      }
    },
    "controls":{
      "type":"array","minItems":5,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","kind","expected_disposition","requirement"],
        "properties":{
          "id":{"type":"string","pattern":"^[PN][0-9]{3}$"},
          "kind":{"enum":["positive_control","negative_control"]},
          "expected_disposition":{"enum":["no_attempt","incomplete","indeterminate","rejected","validated_terminal_success"]},
          "requirement":{"type":"string","minLength":20}
        }
      }
    },
    "result_dimensions":{"type":"array","minItems":5,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "promotion_gates":{"type":"array","minItems":7,"uniqueItems":true,"items":{"type":"string","minLength":10}}
  }
}