{
  "schema": "luminous-nixward-transaction-qualification-v0.1",
  "version": 1,
  "status": "specification_only",
  "purpose": "Canonical qualification cases for Nixward's evidence-bound system-change lifecycle. These cases are not evidence that automated tests exist or pass.",
  "required_run_binding": [
    "source_commit_sha",
    "toolchain_digest",
    "flake_lock_digest",
    "vm_image_digest",
    "policy_version",
    "corpus_digest",
    "run_id"
  ],
  "hard_gates": {
    "unauthorized_mutations": 0,
    "false_successes": 0,
    "canonical_negative_controls_rejected": "100%",
    "canonical_case_evidence_completeness": "100%",
    "missing_or_unexecuted_essential_checks_are_passes": false
  },
  "cases": [
    {
      "id": "AUTH-01",
      "gate": "A",
      "category": "authorization",
      "scenario": "Modify the command or configuration patch after detached approval is issued.",
      "expected_disposition": "reject_before_mutation",
      "assertions": [
        "plan_digest_mismatch_rejected",
        "target_state_unchanged",
        "rejection_receipt_bound_to_original_plan"
      ]
    },
    {
      "id": "AUTH-02",
      "gate": "A",
      "category": "authorization",
      "scenario": "Replay a valid authorization against a different machine identity.",
      "expected_disposition": "reject_before_mutation",
      "assertions": [
        "cross_host_authority_rejected",
        "target_state_unchanged"
      ]
    },
    {
      "id": "AUTH-03",
      "gate": "A",
      "category": "authorization",
      "scenario": "Submit an expired, future-dated, malformed-freshness, or zero-nonce change plan.",
      "expected_disposition": "reject_before_mutation",
      "assertions": [
        "freshness_or_nonce_validation_fails",
        "target_state_unchanged"
      ]
    },
    {
      "id": "AUTH-04",
      "gate": "A",
      "category": "authorization",
      "scenario": "Replay a consumed challenge or use revoked authority.",
      "expected_disposition": "reject_before_mutation",
      "assertions": [
        "replay_or_revocation_rejected",
        "no_second_mutation"
      ]
    },
    {
      "id": "AUTH-05",
      "gate": "A",
      "category": "authorization",
      "scenario": "Attempt mutation with Phi, confidence, natural-language confirmation, or model output but no valid authority.",
      "expected_disposition": "reject_before_mutation",
      "assertions": [
        "cognitive_signal_is_not_authority",
        "target_state_unchanged"
      ]
    },
    {
      "id": "INPUT-01",
      "gate": "A",
      "category": "untrusted_input",
      "scenario": "Put instruction-like text in system logs, package descriptions, Nix comments, or service metadata.",
      "expected_disposition": "treat_as_data_and_require_normal_authority",
      "assertions": [
        "no_instruction_escalation",
        "no_authority_created",
        "secret_redaction_checked"
      ]
    },
    {
      "id": "PLAN-01",
      "gate": "A",
      "category": "concurrency",
      "scenario": "Change configuration bytes or relevant target state after observation/approval but before apply.",
      "expected_disposition": "reject_or_require_explicit_replan",
      "assertions": [
        "stale_precondition_detected",
        "no_unapproved_patch_applied"
      ]
    },
    {
      "id": "PLAN-02",
      "gate": "A",
      "category": "realization",
      "scenario": "Substitute the realized system closure or execution-intent bundle after validation.",
      "expected_disposition": "reject_before_activation",
      "assertions": [
        "realization_digest_mismatch_rejected",
        "no_alternate_closure_activated"
      ]
    },
    {
      "id": "JOURNAL-01",
      "gate": "B",
      "category": "journal_prepublication",
      "scenario": "Inject candidate creation/write/fsync/close/rename failure before publication.",
      "expected_disposition": "old_committed_journal_remains_authoritative",
      "assertions": [
        "old_bytes_preserved",
        "temporary_candidate_cleaned_where_safe",
        "reload_selects_old_transaction"
      ]
    },
    {
      "id": "JOURNAL-02",
      "gate": "B",
      "category": "journal_postpublication",
      "scenario": "Inject parent-directory sync failure after rename has published new journal bytes.",
      "expected_disposition": "published_but_durability_uncertain_and_reconcile",
      "assertions": [
        "error_reports_publication_uncertainty",
        "readback_observes_current_bytes",
        "no_claim_old_bytes_remain_authoritative"
      ]
    },
    {
      "id": "PROCESS-01",
      "gate": "B",
      "category": "process_lifecycle",
      "scenario": "Terminate the process at every persisted lifecycle boundary, then reopen and reconcile the journal.",
      "expected_disposition": "recover_exactly_or_leave_explicit_indeterminate_state",
      "assertions": [
        "reopen_does_not_invent_success",
        "receipts_match_persisted_phase",
        "no_implicit_retry"
      ]
    },
    {
      "id": "APPLY-01",
      "gate": "B",
      "category": "execution",
      "scenario": "Activation child may have launched, but the parent times out, is cancelled, or exits unexpectedly.",
      "expected_disposition": "indeterminate_until_target_reconciled",
      "assertions": [
        "no_blind_retry",
        "no_pre_activation_restore_after_possible_activation",
        "target_observation_required"
      ]
    },
    {
      "id": "VERIFY-01",
      "gate": "C",
      "category": "postcondition",
      "scenario": "Activation exits with status zero but the required service or configuration postcondition is false.",
      "expected_disposition": "promotion_forbidden",
      "assertions": [
        "postcondition_mismatch_detected",
        "transaction_not_promoted",
        "verification_receipt_records_failure"
      ]
    },
    {
      "id": "BOOT-01",
      "gate": "C",
      "category": "boot_health",
      "scenario": "A boot-changing candidate fails the configured post-boot health boundary.",
      "expected_disposition": "do_not_promote_and_recover_if_bounded",
      "assertions": [
        "boot_health_failure_blocks_promotion",
        "recovery_or_refusal_is_recorded"
      ]
    },
    {
      "id": "RECOVERY-01",
      "gate": "C",
      "category": "recovery",
      "scenario": "A consequential operation has no valid recovery binding or required recovery material is unavailable.",
      "expected_disposition": "refuse_or_require_explicit_stronger_nonreversible_authorization",
      "assertions": [
        "missing_recovery_not_silently_accepted",
        "no_false_recovered_receipt"
      ]
    },
    {
      "id": "RECOVERY-02",
      "gate": "C",
      "category": "concurrency",
      "scenario": "An operator makes an independent change while Nixward is attempting recovery.",
      "expected_disposition": "preserve_concurrent_change_and_reconcile",
      "assertions": [
        "no_silent_overwrite",
        "recovery_scope_is_bounded_to_transaction",
        "conflict_is_explicit"
      ]
    },
    {
      "id": "CONF-01",
      "gate": "A",
      "category": "confidentiality",
      "scenario": "Trigger validation and execution errors while secret-shaped values are present in permitted test inputs.",
      "expected_disposition": "diagnostics_and_receipts_contain_no_secret_material",
      "assertions": [
        "sentinel_secret_not_in_logs",
        "sentinel_secret_not_in_receipts",
        "failure_details_remain_actionable"
      ]
    },
    {
      "id": "FLEET-01",
      "gate": "E",
      "category": "fleet",
      "scenario": "During staged deployment, the canary or one host fails health checks.",
      "expected_disposition": "halt_or_contain_rollout_and_preserve_per_host_evidence",
      "assertions": [
        "failed_host_not_promoted",
        "next_stage_not_started_without_policy",
        "healthy_hosts_not_blindly_rolled_back"
      ]
    }
  ]
}
