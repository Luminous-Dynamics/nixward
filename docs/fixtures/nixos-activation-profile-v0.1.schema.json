{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/nixward-activation-profile-v0.1.json",
  "title": "Nixward exact NixOS activation compatibility profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "profile_id", "nixos_release", "nixpkgs_revision",
    "switch_to_configuration_sha256", "activation_semantics_revision",
    "systemd_version", "observer_adapter_revision", "supported_modes",
    "inhibitor_policy", "requires_deprecated_activation_callbacks",
    "requires_invocation_id", "supports_pidfd_identity"
  ],
  "properties": {
    "schema": { "const": "nixward-activation-profile-v0.1" },
    "version": { "const": 1 },
    "profile_id": { "$ref": "#/$defs/token" },
    "nixos_release": { "$ref": "#/$defs/token" },
    "nixpkgs_revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40,64}$" },
    "switch_to_configuration_sha256": { "$ref": "#/$defs/sha256" },
    "activation_semantics_revision": { "$ref": "#/$defs/token" },
    "systemd_version": { "$ref": "#/$defs/token" },
    "observer_adapter_revision": { "$ref": "#/$defs/token" },
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["switch", "test", "boot", "dry_activate"] }
    },
    "inhibitor_policy": {
      "enum": ["required_comparison", "required_comparison_with_explicit_bypass"]
    },
    "requires_deprecated_activation_callbacks": { "const": false },
    "requires_invocation_id": { "const": true },
    "supports_pidfd_identity": { "type": "boolean" }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:+-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}